generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  isVerified         Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  username           String?             @unique
  familyContacts     FamilyContact[]
  accounts           Account[]
  catchLogs          CatchLog[]
  familyViewSessions FamilyViewSession[]
  liveLocation       LiveLocation?
  locationLogs       LocationLog[]
  pushSubscriptions  PushSubscription[]
  sessions           Session[]
  receivedSpots      SharedSpot[]        @relation("ReceivedSpots")
  sentSpots          SharedSpot[]        @relation("SentSpots")
  sosAlerts          SOSAlert[]
  trips              Trip[]

  @@map("users")
}

model FamilyViewSession {
  id               String        @id @default(cuid())
  userId           String
  code             String        @unique
  phone            String
  message          String?
  frequencyPerHour Int           @default(1)
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  isActive         Boolean       @default(true)
  expiresAt        DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationLogs     LocationLog[]

  @@index([userId])
  @@map("family_view_sessions")
}

model LocationLog {
  id          String            @id @default(cuid())
  sessionId   String
  userId      String
  latitude    Float
  longitude   Float
  areaName    String?
  sentAt      DateTime          @default(now())
  sendSuccess Boolean           @default(true)
  session     FamilyViewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, sentAt])
  @@map("location_logs")
}

model MissingReportAudit {
  id             String   @id @default(cuid())
  reportedUserId String
  reporterName   String
  reporterPhone  String
  createdAt      DateTime @default(now())

  @@index([reportedUserId, createdAt])
  @@map("missing_report_audits")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  id         String   @id @default(cuid())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CatchLog {
  id       String   @id @default(cuid())
  userId   String
  fishType String
  weight   Float
  location String
  caughtAt DateTime @default(now())
  tripId   String?
  trip     Trip?    @relation("CatchLogToTrip", fields: [tripId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("catch_logs")
}

model Trip {
  id                 String              @id @default(cuid())
  userId             String
  status             String              @default("ACTIVE")
  startTime          DateTime            @default(now())
  endTime            DateTime?
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  catchLogs          CatchLog[]          @relation("CatchLogToTrip")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  waNotificationLogs WaNotificationLog[]

  @@map("trips")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model LiveLocation {
  id        String   @id @default(cuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  isSharing Boolean  @default(false)
  isSOS     Boolean  @default(false)
  lastSeen  DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_locations")
}

model SOSAlert {
  id         String    @id @default(cuid())
  userId     String
  latitude   Float
  longitude  Float
  message    String?
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sos_alerts")
}

model SharedSpot {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  recipient   User     @relation("ReceivedSpots", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentSpots", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("shared_spots")
}

model FamilyContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WaNotificationLog {
  id             String   @id @default(cuid())
  tripId         String
  recipientPhone String
  messageType    String
  sentAt         DateTime @default(now())
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sentAt])
  @@map("wa_notification_logs")
}
